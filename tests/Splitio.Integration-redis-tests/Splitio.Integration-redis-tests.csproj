<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net472</TargetFrameworks>
    <RootNamespace>Splitio.Integration_redis_tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.8" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Splitio.Redis\Splitio.Redis.csproj" />
    <ProjectReference Include="..\..\src\Splitio\Splitio.csproj" />
    <ProjectReference Include="..\Splitio.Tests.Common\Splitio.Tests.Common.csproj" />
  </ItemGroup>

  <!--
    Tests use [DeploymentItem(@"Resources\...")] with a Windows path separator, which MSTest only resolves on Windows.
    On other platforms, copy the shared test data files to the output root, where the tests expect them.
  -->
  <Target Name="CopyResourcesToOutputRoot" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <_ResourceFile Include="..\Splitio.Tests.Common\Resources\**\*" Exclude="..\Splitio.Tests.Common\Resources\**\*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(_ResourceFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
